<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TOP PAGE</title>
    <link rel="stylesheet" href="src/css/sanitize.css">
    <link rel="stylesheet" href="src/css/style.css">
    <link rel="stylesheet" href="src/css/search.css">
    <link rel="stylesheet" href="src/css/card.css">

    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search" />
</head>

<body>
    <header>
        <div class="top">
            <h1>Service Name</h1>
            <a href="model.html">モデル</a>
            <div class="user">
                <img src="https://placehold.jp/128x128.png" alt="Usericon">
            </div>
        </div>

        <nav>
            <ul>
                <li><a href="search.html">作品を探す</a></li>
                <li><a href="">作品を編集する</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="main">
            <section class="word-search">
                <h2>語句から探す</h2>
                <form>
                    <label for="search-box">作品を検索</label>
                    <button type="submit"><span class="material-symbols-outlined">search</span></button>
                    <input type="search" name="search" id="search-box" placeholder="作品タイトルか作者を入力" maxlength="80">
                </form>
            </section>
            <section class="tags-search">
                <h2>タグから探す</h2>
                <h3>現在選択中のタグ</h3>
                <div class="current">
                    <button type="submit"><span class="material-symbols-outlined">search</span></button>
                    <ul class="tags">
                        <li>恋愛</li>
                        <li>ご飯</li>
                        <li>GL</li>
                    </ul>
                </div>
                <h3>タグ一覧から選択</h3>
                <ul class="tag-list tags">
                    <li>ファンタジー</li>
                    <li>バトル</li>
                    <li>転生</li>
                    <li>ギャグ</li>
                    <li>コメディ</li>
                    <li>恋愛</li>
                    <li>ご飯</li>
                    <li>GL</li>
                    <li>NL</li>
                    <li>BL</li>
                </ul>
            </section>
            <section class="popular">
                <h2>人気順から探す</h2>
                <div class="x-scroll">

                    <a href="" class="manga-card">
                        <img src="https://placehold.jp/100x142.png" alt="書影">
                        <h3>タイトル</h3>
                    </a>
